ADMIN_SECRET=change-me-to-a-long-random-string
# Public site URL (used for social sharing and Open Graph)
NEXT_PUBLIC_SITE_URL=https://kamalvscockroach.com
# Legal pages (Razorpay / compliance)
NEXT_PUBLIC_BUSINESS_NAME=Ninetyone Software Solutions
NEXT_PUBLIC_SUPPORT_EMAIL=support@kamalvscockroach.com
# Encrypts the hidden master image on disk (defaults to ADMIN_SECRET if unset)
MASTER_ENCRYPTION_KEY=

# Razorpay payments (optional — without these, demo checkout stays enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook secret from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# --- Small deploy (~10k requests/day) ---
# Only ADMIN_SECRET is required. Uses the data/ folder on disk.
# On Railway: attach a 1 GB volume mounted at /app/data
# Estimated cost: Railway Hobby ~$5–15/mo (single web service + volume)

# --- Scale up later (100k+ requests/day) ---
# Uncomment when you outgrow file storage:
# DATABASE_URL=postgres://user:pass@host:5432/pixelproject
# REDIS_URL=redis://default:pass@host:6379
# STATUS_CACHE_TTL_SEC=15
# REVEALED_CACHE_MAX_AGE_SEC=60
# PG_POOL_MAX=20
