# Generate: openssl rand -base64 32
ADMIN_SECRET=
# Obscure admin URL (not /admin). Set both to the same random slug, e.g. openssl rand -hex 16
ADMIN_PANEL_PATH=k9v-m2x7-q4p1-n8w3
NEXT_PUBLIC_ADMIN_PANEL_PATH=k9v-m2x7-q4p1-n8w3
# Public site URL (used for social sharing and Open Graph)
NEXT_PUBLIC_SITE_URL=https://kamalvscockroach.com
# Competition deadline (ISO 8601, IST recommended). Default: 10 days from deploy.
NEXT_PUBLIC_VOTING_END_ISO=2026-06-05T23:59:59+05:30
# Public business identity (shown on site)
NEXT_PUBLIC_BUSINESS_NAME=Ninetyone Software Solutions
NEXT_PUBLIC_SUPPORT_EMAIL=kamalvscockroach@gmail.com
# Required in production — must differ from ADMIN_SECRET (openssl rand -base64 32)
MASTER_ENCRYPTION_KEY=

# Payments — Cashfree (required for online checkout)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

